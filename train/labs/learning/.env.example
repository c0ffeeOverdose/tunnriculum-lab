# Per-instance env. Copy to instances/<name>.env and fill.
PREFIX=lab1-
WG_PORT=51820
WG_SERVERURL=auto

NET_DMZ=10.100.100.0/24
NET_INT=10.100.200.0/24
NET_RES=10.100.250.0/24

IP_WG=10.100.100.2
IP_KALI=10.100.100.50
IP_DB=10.100.200.20
IP_WEB_DMZ=10.100.100.10
IP_WEB_INT=10.100.200.5
IP_POS_INT=10.100.200.10
IP_POS_RES=10.100.250.5
IP_BACKUP=10.100.250.10

# Story: the IT guy reuses ONE password everywhere — POS_PASS must equal DB_PASS
DB_PASS=changeme-db
POS_PASS=changeme-db
BACKUP_PASS=changeme-backup

# Browser Kali desktop (noVNC) + native RDP + SSH — VNC passwords are 6-8 chars max
KALI_VNC_PASS=changeme8
KALI_PORT=6080
KALI_RDP_PORT=3389
KALI_SSH_PORT=2222

FLAG1=flag{dev_flag_1}
FLAG2=flag{dev_flag_2}
FLAG3=flag{dev_flag_3}
