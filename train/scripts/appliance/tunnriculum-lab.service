[Unit]
Description=Tunnriculum lab stack (docker-compose up on every boot)
Wants=network-online.target
After=network-online.target docker.service tunnriculum-firstboot.service
ConditionPathExists=/home/lab/tunnriculum/train/instances/tunnriculum.env

[Service]
Type=oneshot
User=lab
WorkingDirectory=/home/lab/tunnriculum/train
ExecStart=/home/lab/tunnriculum/train/scripts/lab.sh up
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
